{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/hopper-documentation-openai/scripts/hopper_documentation_openai.py\" copia",
            "timeout": 120,
            "statusMessage": "Copying the full conversation before compaction"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/hopper-documentation-openai/scripts/hopper_documentation_openai.py\" escrita",
            "async": true,
            "timeout": 3600,
            "statusMessage": "Documenting the conversation in the background"
          }
        ]
      }
    ]
  }
}
