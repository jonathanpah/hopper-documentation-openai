{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/hopper-documentation-openai/scripts/hopper_documentation.py\" hook",
            "async": true,
            "timeout": 1800,
            "statusMessage": "Registrando continuidade em segundo plano"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/hopper-documentation-openai/scripts/hopper_documentation.py\" hook",
            "timeout": 10,
            "statusMessage": "Consultando o último registro desta conversa"
          }
        ]
      }
    ]
  }
}
